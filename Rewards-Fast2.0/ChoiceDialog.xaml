<Window x:Class="Rewards_Fast2._0.ChoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбор варианта склонения"
        Height="500" Width="850"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource BackgroundColor}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="⚠️ Обнаружены расхождения в склонении" 
                   FontSize="16" FontWeight="Bold" Margin="0,0,0,15"
                   Foreground="#2D6A2D"
                   HorizontalAlignment="Center"/>

        <Border Grid.Row="1" Background="{StaticResource PanelBackground}" 
                BorderBrush="{StaticResource BorderColor}" BorderThickness="1" 
                CornerRadius="8" Padding="10" Margin="0,0,0,15">
            <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="ExamplesText" TextWrapping="Wrap" 
                           Foreground="{StaticResource TitleColor}" FontSize="12"/>
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="2" Text="Какой вариант использовать для проблемных ФИО?" 
                   FontSize="13" FontWeight="SemiBold" Margin="0,0,0,20"
                   Foreground="{StaticResource TitleColor}"
                   HorizontalAlignment="Center"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
            <Button x:Name="Option1Button" Content="📚 Вариант 1 (NPetrovich)" 
                    Width="240" Margin="0,0,15,0" Padding="12,10" FontSize="13"
                    Click="Option1Button_Click"/>
            <Button x:Name="Option2Button" Content="✍️ Вариант 2 (самописный)" 
                    Width="240" Margin="0,0,15,0" Padding="12,10" FontSize="13"
                    Click="Option2Button_Click"/>
            <Button x:Name="CancelButton" Content="❌ Отмена" 
                    Width="100" Padding="12,10" FontSize="13"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>