<Window x:Class="Rewards_Fast2._0.ChoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбор варианта склонения ФИО" 
        Height="550" Width="900"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{StaticResource BackgroundColor}">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" 
                   Text="⚠️ Обнаружены расхождения в склонении ФИО" 
                   FontSize="16" FontWeight="Bold" 
                   Foreground="#2D6A2D"
                   HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <!-- Информация -->
        <Border Grid.Row="1" 
                Background="{StaticResource PanelBackground}" 
                BorderBrush="{StaticResource BorderColor}" 
                BorderThickness="1" CornerRadius="8" 
                Padding="10" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock x:Name="InfoText" 
                           TextWrapping="Wrap" 
                           Foreground="{StaticResource TitleColor}" 
                           FontSize="12" Margin="0,0,0,10"/>
                <TextBlock Text="💡 Подсказка: дважды кликните по строке или выберите вариант в списке" 
                           FontSize="11" FontStyle="Italic" 
                           Foreground="#666666"/>
            </StackPanel>
        </Border>

        <!-- Таблица с проблемными ФИО -->
        <Border Grid.Row="2" 
                Background="{StaticResource PanelBackground}" 
                BorderBrush="{StaticResource BorderColor}" 
                BorderThickness="1" CornerRadius="8" 
                Padding="5" Margin="0,0,0,15">
            <DataGrid x:Name="ProblemsGrid" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      RowHeight="35"
                      SelectionMode="Single"
                      MouseDoubleClick="ProblemsGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Исходное ФИО" 
                                        Binding="{Binding FullName}" 
                                        Width="250" 
                                        IsReadOnly="True"/>

                    <DataGridTextColumn Header="Вариант 1 (NPetrovich)" 
                                        Binding="{Binding Option1}" 
                                        Width="*" 
                                        IsReadOnly="True"/>

                    <DataGridTextColumn Header="Вариант 2 (самописный)" 
                                        Binding="{Binding Option2}" 
                                        Width="*" 
                                        IsReadOnly="True"/>

                    <DataGridTemplateColumn Header="Выбранный вариант" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox SelectedValue="{Binding SelectedOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          SelectedValuePath="Tag"
                                          FontSize="12">
                                    <ComboBoxItem Tag="Library">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📚 " />
                                            <TextBlock Text="Вариант 1" />
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="Fallback">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="✍️ " />
                                            <TextBlock Text="Вариант 2" />
                                        </StackPanel>
                                    </ComboBoxItem>
                                </ComboBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Кнопки массовых действий -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" 
                    HorizontalAlignment="Center" Margin="0,0,0,15">
            <Button x:Name="AllOption1Button" 
                    Content="📚 Всем вариант 1" 
                    Width="140" Margin="0,0,10,0" 
                    Padding="8,6"
                    Click="AllOption1Button_Click"/>

            <Button x:Name="AllOption2Button" 
                    Content="✍️ Всем вариант 2" 
                    Width="140" Margin="0,0,10,0" 
                    Padding="8,6"
                    Click="AllOption2Button_Click"/>

            <Button x:Name="ResetButton" 
                    Content="🔄 Сбросить выбор" 
                    Width="132" Margin="0,0,10,0" 
                    Padding="8,6"
                    Click="ResetButton_Click"/>
        </StackPanel>

        <!-- Кнопки действий (Отмена убрана, только генерация и пропуск) -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" 
                    HorizontalAlignment="Center">
            <Button x:Name="GenerateButton" 
                    Content="✨ Сгенерировать с выбранными вариантами" 
                    Width="313" Margin="0,0,15,0" 
                    Padding="12,8" FontSize="13"
                    Style="{StaticResource GenerateButtonStyle}"
                    Click="GenerateButton_Click"/>

            <Button x:Name="SkipButton" 
                    Content="⏭️ Пропустить генерацию проблемных ФИО" 
                    Width="327" Margin="0,0,0,0" 
                    Padding="12,8" FontSize="13"
                    Click="SkipButton_Click"/>
        </StackPanel>
    </Grid>
</Window>