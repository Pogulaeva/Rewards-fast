<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Rewards_Fast2._0</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
	<UseWindowsForms>true</UseWindowsForms>
	<ApplicationIcon>Resources\Rewards fast.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Resources\Backgrounds\Благодарность1.jpg" />
    <None Remove="Resources\Backgrounds\Благодарность2.jpg" />
    <None Remove="Resources\Backgrounds\Благодарственное письмо1.jpg" />
    <None Remove="Resources\Backgrounds\Грамота1.jpg" />
    <None Remove="Resources\Backgrounds\Грамота2.jpg" />
    <None Remove="Resources\Backgrounds\Почётная грамота1.jpg" />
    <None Remove="Resources\Rewards fast.ico" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\Rewards fast.ico">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EPPlus" Version="8.5.1" />
    <PackageReference Include="NPetrovich" Version="2.0.1" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.5" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Backgrounds\Благодарность1.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\Backgrounds\Благодарность2.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\Backgrounds\Благодарственное письмо1.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\Backgrounds\Грамота1.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\Backgrounds\Грамота2.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\Backgrounds\Почётная грамота1.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\Rewards fast.ico" />
  </ItemGroup>

</Project>
